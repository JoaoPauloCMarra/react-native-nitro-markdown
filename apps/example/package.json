{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "bun run android:assemble && env -u NO_COLOR expo run:android --binary android/app/build/outputs/apk/debug/app-debug.apk",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "install-check": "env -u NO_COLOR expo install --check",
    "doctor": "env -u NO_COLOR bunx expo-doctor",
    "config:introspect": "env -u NO_COLOR expo config --type introspect --json > /tmp/nitro-markdown-expo-config.json",
    "lint": "bunx eslint app components hooks --max-warnings=0",
    "android:assemble": "cd android && ./gradlew --no-configuration-cache :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroMarkdown.xcworkspace -scheme NitroMarkdown -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-build-properties": "~57.0.14",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "ratex-react-native": "0.1.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mathjax-svg": "^0.9.9",
    "react-native-nitro-markdown": "workspace:*",
    "react-native-nitro-modules": "0.37.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/commonmark": "^0.27.10",
    "@types/markdown-it": "^14.2.0",
    "@types/marked": "^6.0.0",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.7",
    "commonmark": "^0.31.2",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.10",
    "typescript": "~6.0.3"
  }
}
