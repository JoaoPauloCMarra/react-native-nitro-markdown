{
  "name": "example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "env -u NO_COLOR expo start -d",
    "ios": "env -u NO_COLOR expo run:ios",
    "android": "bun run android:assemble && env -u NO_COLOR expo run:android --binary android/app/build/outputs/apk/debug/app-debug.apk",
    "prebuild": "env -u NO_COLOR expo prebuild",
    "prebuild:clean": "env -u NO_COLOR expo prebuild --clean",
    "install-check": "env -u NO_COLOR expo install --check",
    "doctor": "env -u NO_COLOR bunx expo-doctor@1.21.5",
    "config:introspect": "env -u NO_COLOR expo config --type introspect --json > /tmp/nitro-markdown-expo-config.json",
    "lint": "bunx eslint app components hooks --max-warnings=0",
    "android:assemble": "cd android && ./gradlew --no-configuration-cache :app:assembleDebug",
    "ios:build": "cd ios && pod install && xcodebuild -workspace NitroMarkdown.xcworkspace -scheme NitroMarkdown -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "ratex-react-native": "0.1.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mathjax-svg": "^0.9.9",
    "react-native-nitro-markdown": "workspace:*",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.18",
    "typescript": "~6.0.3"
  }
}
