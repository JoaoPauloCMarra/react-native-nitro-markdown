open "com.nitromarkdown.example" "nitromarkdown://e2e" --relaunch
wait "stable"
wait id="e2e-screen"
wait text "e2e-ready"
wait id="e2e-lab"
wait id="e2e-parse-status"
wait text "ok:parse=structure"
wait id="e2e-extract-status"
wait text "ok:extract=bold and italic"
wait id="e2e-session-status"
wait text "ok:session=append-replace-reset"
wait id="e2e-comparison-status"
wait text "ok:comparison"
wait id="e2e-error-status"
wait text "ok:error=input_too_large"
wait id="e2e-stress-result"
wait text "ok:parses=40:blocks="
wait id="plugin-smoke-status"
wait text "PASS — Markdown plugin pipeline passed"
close
