open "com.nitromarkdown.example" --relaunch
wait "stable"
wait id="open-e2e-lab"
press id="open-e2e-lab"
wait id="e2e-screen"
wait text "e2e-ready"
wait id="e2e-lab"
press id="e2e-parse-run"
wait text "ok:parse=structure"
press id="e2e-extract-run"
wait text "ok:extract=bold and italic"
press id="e2e-session-run"
wait text "ok:session=append-replace-reset"
press id="e2e-comparison-run"
wait text "ok:comparison"
press id="e2e-error-run"
wait text "ok:error=input_too_large"
press id="e2e-run-stress"
wait text "ok:parses=40:blocks="
close
