open "com.nitromarkdown.example" --relaunch
wait "stable"
wait id="open-e2e-lab"
press id="open-e2e-lab"
wait id="e2e-screen"
press id="open-e2e-render"
wait id="e2e-render-screen"
wait text "e2e-ready"
wait id="e2e-render-ready-count"
wait text "ok:ready=8/8:ms="
wait text "Paragraph with bold"
press id="e2e-stream-burst"
wait id="e2e-stream-status"
wait text "ok:burst=tokens-0-through-23:chars="
scroll bottom
wait text "Plugin specimen"
wait text "Token 0"
wait text "Token 23"
scroll top
press id="e2e-render-remount"
wait id="e2e-render-generation"
wait text "generation:1"
wait text "ok:ready=8/8:ms="
close
