open "com.nitromarkdown.example" "nitromarkdown://e2e-render-contracts" --relaunch
wait "stable"
wait id="e2e-render-contracts-screen"
wait id="render-contracts-probe"
wait id="error-text-surface"
wait text "ERR_TEXT_OK"
wait text "errortext=parse;"
wait id="custom-heading-marker"
wait text "custom=heading-2;"
wait id="html-surface"
wait text "<div>HTML_BLOCK</div>"
wait text "html=inline+block;"
wait id="code-language-surface"
wait text "e2elang"
wait text "hl=ts:"
wait id="table-surface"
wait text "Table: Alpha, Beta"
wait text "tablew>=240:ctl<240;"
wait id="math-surface"
wait text "E2Emath^{2}"
wait text "async=initializing>available;"
wait text "reason=beforeParse-plugin;"
wait text "streamerr=parse;"
scroll down
press id="link-press-target"
wait text "link=https://example.test:blocked;"
close
