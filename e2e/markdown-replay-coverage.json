{
  "version": 1,
  "entry": "scripts/run-example-replay.js",
  "sourceScope": [
    "Markdown TypeScript, native C++/Android wiring, generated bindings, package manifests and workspace lock",
    "All example source and assets except generated Android/iOS projects, test files, caches and secrets",
    "Replay flows and coverage assertions"
  ],
  "suites": [
    {
      "id": "full-features",
      "path": "e2e/qa-full-features.ad",
      "purpose": "Native parsing, extraction, session mutations, input bounds and plugin recovery"
    },
    {
      "id": "render-stress",
      "path": "e2e/qa-render-stress.ad",
      "purpose": "Eight renderer specimens, exact native stream burst content and remount completion"
    },
    {
      "id": "deeplink",
      "path": "e2e/qa-deeplink.ad",
      "purpose": "Installed E2E deep-link routing"
    },
    {
      "id": "contracts",
      "path": "e2e/qa-contracts.ad",
      "purpose": "Public empty-host image policy, inline PNG decoding and committed stream session isolation"
    },
    {
      "id": "smoke",
      "path": "e2e/qa-smoke.ad",
      "purpose": "In-app native smoke suite on the tabs root with a zero-failure count probe"
    },
    {
      "id": "api",
      "path": "e2e/qa-api.ad",
      "purpose": "Run-on-load public parser, headless subpath, session error codes, listener and useStream contracts"
    },
    {
      "id": "render-contracts",
      "path": "e2e/qa-render-contracts.ad",
      "purpose": "Renderer props, accessibility labels, table width options, stream state reasons and link press interception"
    },
    {
      "id": "contracts-http",
      "path": "e2e/qa-contracts-http.ad",
      "purpose": "Remote image host policy against the local HTTP fixture request log",
      "requires": "http-fixture"
    },
    {
      "id": "text-scale",
      "path": "e2e/qa-text-scale.ad",
      "purpose": "OS text-size scaling of a rendered Markdown body paragraph against a non-scaling baseline; changes device text size, restores medium, and must run last"
    }
  ],
  "features": [
    {
      "id": "parser.structure",
      "coverage": "replay-asserted",
      "kind": "public-api",
      "transport": "Native parser AST contains document, heading, list, table and math nodes plus the task text.",
      "suite": "e2e/qa-full-features.ad",
      "source": "apps/example/components/e2e-lab.tsx",
      "trigger": "screen-load",
      "statusId": "e2e-parse-status",
      "expectedText": "ok:parse=structure",
      "assertion": "getFlattenedText(ast).includes(\"Task\")"
    },
    {
      "id": "parser.extract",
      "coverage": "replay-asserted",
      "kind": "public-api",
      "transport": "Native extraction and flattened native AST agree on exact plain text.",
      "suite": "e2e/qa-full-features.ad",
      "source": "apps/example/components/e2e-lab.tsx",
      "trigger": "screen-load",
      "statusId": "e2e-extract-status",
      "expectedText": "ok:extract=bold and italic",
      "assertion": "plain === \"bold and italic\" && flat === plain"
    },
    {
      "id": "session.mutations",
      "coverage": "replay-asserted",
      "kind": "public-api",
      "transport": "Native session append, replace and reset return the expected complete strings.",
