open "com.nitromarkdown.example" "nitromarkdown://e2e-contracts" --relaunch
wait "stable"
wait id="e2e-contracts-screen"
wait id="image-blocked-surface"
wait text "Image failed to load"
wait id="image-allowed-surface"
wait text "INLINE_IMAGE_LOADED"
scroll bottom
wait id="session-direct-status"
wait text "direct:ready:session-A"
wait text "ALPHA_DIRECT"
press id="session-direct-switch"
wait text "direct:PASS:session-B:text+ast:stale=0"
wait text "BETA_DIRECT"
press id="session-direct-confirm"
wait text "direct:PASS:current-update:text+ast:stale=0"
wait text "BETA_DIRECT_CONFIRMED"
wait id="session-transition-status"
wait text "transition:ready:session-A"
wait text "ALPHA_TRANSITION"
press id="session-transition-switch"
wait text "transition:PASS:session-B:text+ast:stale=0"
wait text "BETA_TRANSITION"
press id="session-transition-confirm"
wait text "BETA_TRANSITION_CONFIRMED"
wait text "transition:PASS:current-update:text+ast:stale=0"
close
