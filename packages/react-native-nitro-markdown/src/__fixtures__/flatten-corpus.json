    "markdown": "---",
    "expected": "---\n\n"
  },
  {
    "name": "code-block",
    "markdown": "```ts\nconst x = 1;\n```",
    "expected": "const x = 1;\n\n"
  },
  {
    "name": "standalone-math-block",
    "markdown": "$$\nx + y\n$$",
    "expected": "x + y\n\n"
  },
  {
    "name": "blockquote",
    "markdown": "> Quoted",
    "expected": "Quoted\n\n"
  },
  {
    "name": "blockquote-multiline",
    "markdown": "> One\n> Two",
    "expected": "One Two\n\n"
  },
  {
    "name": "multiple-blocks",
    "markdown": "# Title\n\nBody text",
    "expected": "Title\n\nBody text\n\n"
  },
  {
    "name": "inline-math",
    "markdown": "a $x^2$ b",
    "expected": "a x^2 b\n\n",
    "ast": {
      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "content": "a "
            },
            {
              "type": "math_inline",
              "children": [
                {
                  "type": "text",
                  "content": "x^2"
                }
              ]
            },
            {
              "type": "text",
              "content": " b"
            }
          ]
        }
      ]
    }
  },
  {
    "name": "html-block",
    "markdown": "<div>hi</div>",
    "options": {
      "html": true
    },
    "expected": "<div>hi</div>\n\n",
    "ast": {
      "type": "document",
      "children": [
        {
          "type": "html_block",
          "content": "<div>hi</div>\n"
        }
      ]
    }
  },
  {
    "name": "image-title-empty-alt",
    "markdown": "![](u \"Title\")",
    "expected": "Title\n\n",
