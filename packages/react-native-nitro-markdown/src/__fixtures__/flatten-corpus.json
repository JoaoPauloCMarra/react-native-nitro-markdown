      "type": "document",
      "children": [
        {
          "type": "paragraph",
          "children": [
            {
              "type": "image",
              "href": "u",
              "alt": "",
              "title": "Title"
            }
          ]
        }
      ]
    }
  },
  {
    "name": "ideographic-space",
    "markdown": "　a　",
    "expected": "a\n\n"
