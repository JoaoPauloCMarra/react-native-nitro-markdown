{
  "name": "react-native-nitro-markdown-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "publish-package": "bun scripts/publish.js",
    "publish-package:dry-run": "bun scripts/publish.js --dry-run --yes",
    "audit:package": "bun run build && bun scripts/publish.js --dry-run --skip-preflight --skip-checks --skip-docs --yes",
    "harness": "bun scripts/harness.js",
    "dev": "bun run example:start",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:cpp",
    "check:ci": "bun run verify:core-versions && bun run harness && bun run typecheck:rn087",
    "release:preflight": "bun run check:ci && bun run example:check && bun run publish-package:dry-run",
    "build": "bun run codegen && bun run --cwd packages/react-native-nitro-markdown build",
    "lint": "bun run --cwd packages/react-native-nitro-markdown lint",
    "clean": "bun run --cwd packages/react-native-nitro-markdown clean",
    "codegen": "bun run --cwd packages/react-native-nitro-markdown codegen",
    "codegen:check": "bun scripts/check-codegen.ts",
    "verify:core-versions": "bun scripts/verify-core-versions.ts",
    "typecheck": "bun run --cwd packages/react-native-nitro-markdown typecheck",
    "typecheck:rn087": "bun scripts/verify-rn087-types.ts",
    "typecheck:public": "bun run build && bunx tsc -p type-tests/tsconfig.json",
    "test": "bun run --cwd packages/react-native-nitro-markdown test",
    "test:coverage": "bun run --cwd packages/react-native-nitro-markdown test:coverage",
    "test:cpp": "bun run --cwd packages/react-native-nitro-markdown test:cpp",
    "test:cpp:coverage": "bun run --cwd packages/react-native-nitro-markdown test:cpp:coverage",
    "size": "bun run --cwd packages/react-native-nitro-markdown size",
    "benchmark": "bun scripts/benchmark-comparison.js",
    "example:start": "bun run --cwd apps/example start",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean",
    "example:install-check": "bun run --cwd apps/example install-check",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:config": "bun run --cwd apps/example config:introspect",
    "example:lint": "bun run --cwd apps/example lint",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:check": "bun run example:lint && bun run example:typecheck && bun run example:install-check && bun run example:doctor && bun run example:config",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:smoke": "bun scripts/example-smoke.js",
    "example:smoke:android": "bun scripts/example-smoke.js --android",
    "example:smoke:ios": "bun scripts/example-smoke.js --ios"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/commonmark": "^0.27.10",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.18",
    "commonmark": "^0.31.2",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.10",
    "nitrogen": "0.37.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-font": "~57.0.1"
  },
  "dependencies": {
    "react-native-nitro-modules": "0.37.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "unrs-resolver"
  ]
}
