{
  "name": "react-native-nitro-markdown-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "publish-package": "bun scripts/publish.js",
    "publish-package:dry-run": "bun scripts/publish.js --dry-run --yes",
    "publish-package:pack-check": "bun scripts/publish.js --dry-run --skip-checks --yes",
    "audit:package": "bun run build && bun scripts/publish.js --dry-run --skip-preflight --skip-checks --skip-docs --yes",
    "harness": "bun scripts/harness.js",
    "dev": "bun run example:start",
    "check": "bun run example:replay:check && bun run example:replay:test && bun run lint && bun run typecheck && bun run test && bun run test:cpp && bun run test:lifecycle",
    "check:ci": "bun run example:replay:check && bun run example:replay:test && bun run verify:core-versions && bun run harness && bun run typecheck:rn087 && bun run test:lifecycle && bun run test:cpp:sanitizers && bun run audit:package",
    "release:preflight": "bun run check:ci && bun run example:check && bun run publish-package:pack-check",
    "build": "bun run --cwd packages/react-native-nitro-markdown build",
    "lint": "bun run --cwd packages/react-native-nitro-markdown lint && bunx --no-install eslint scripts/run-example-replay.js scripts/replay-manifest.js scripts/check-example-replay-freshness.js scripts/example-replay-http-fixture.js scripts/example-replay.test.ts --max-warnings=0",
    "clean": "bun run --cwd packages/react-native-nitro-markdown clean",
    "codegen": "bun run --cwd packages/react-native-nitro-markdown codegen",
    "codegen:check": "bun scripts/check-codegen.ts",
    "verify:core-versions": "bun scripts/verify-core-versions.ts",
    "typecheck": "bun run --cwd packages/react-native-nitro-markdown typecheck",
    "typecheck:rn087": "bun scripts/verify-rn087-types.ts",
    "typecheck:public": "bun run build && bun scripts/check-public-types.ts",
    "test": "bun run --cwd packages/react-native-nitro-markdown test",
    "test:lifecycle": "bun test ./scripts/setup.test.ts ./scripts/audit-doc-contracts.test.ts ./scripts/benchmark-stream-ast.test.ts ./scripts/check-codegen.test.ts ./scripts/generated-snapshot.test.ts ./scripts/package-source-entries.test.ts ./scripts/publish-pipeline.test.ts && node --test scripts/process-runner.node.test.mjs && node scripts/package-doc-lifecycle.test.js && bun test ./scripts/build-composition.test.ts",
    "test:coverage": "bun run --cwd packages/react-native-nitro-markdown test:coverage",
    "test:cpp": "bun run --cwd packages/react-native-nitro-markdown test:cpp",
    "test:cpp:sanitizers": "bun run --cwd packages/react-native-nitro-markdown test:cpp:sanitizers",
    "test:cpp:tsan": "bun run --cwd packages/react-native-nitro-markdown test:cpp:tsan",
    "test:cpp:perf": "bun run --cwd packages/react-native-nitro-markdown test:cpp:perf",
    "test:cpp:coverage": "bun run --cwd packages/react-native-nitro-markdown test:cpp:coverage",
    "size": "bun run --cwd packages/react-native-nitro-markdown size",
    "benchmark": "bun scripts/benchmark-stream-ast.js HEAD",
    "benchmark:compare": "node scripts/benchmark-comparison.js",
    "example:start": "bun run --cwd apps/example start",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean",
    "example:install-check": "bun run --cwd apps/example install-check",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:config": "bun run --cwd apps/example config:introspect",
    "example:lint": "bun run --cwd apps/example lint",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:check": "bun run example:lint && bun run example:typecheck && bun run example:install-check && bun run example:doctor && bun run example:config",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:smoke": "bun scripts/example-smoke.js",
    "example:smoke:android": "bun scripts/example-smoke.js --android",
    "example:smoke:ios": "bun scripts/example-smoke.js --ios",
    "example:replay": "bun run example:replay:check && bun scripts/run-example-replay.js",
    "example:replay:check": "bun scripts/check-example-replay-freshness.js --check",
    "example:replay:refresh": "bun scripts/check-example-replay-freshness.js --refresh",
    "example:replay:test": "bun test scripts/example-replay.test.ts"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint-config-expo": "^58.0.4",
    "jest": "^29.7.0",
    "nitrogen": "0.37.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.2",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001810",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.0",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13"
  },
  "dependencies": {
    "react-native-nitro-modules": "0.37.1"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "unrs-resolver"
  ]
}
