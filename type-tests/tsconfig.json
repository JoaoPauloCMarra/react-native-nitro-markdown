{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2020"
    ],
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": [
    "public-api.ts"
  ]
}
